[Unit]
Description=Yue Studio Worker (API :8091, резидентная YuE2Pipeline)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/dsamotoy/yue-studio
Environment=HF_HOME=/mnt/e/AI/hf-cache
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ExecStart=/home/dsamotoy/yue/.venv/bin/python -m uvicorn yue_worker:app --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
